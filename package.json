{
  "name": "davinci-console-demo",
  "version": "0.13.3",
  "private": false,
  "description": "[DEMO] dsh-davinci-console-demo（npm: davinci-console-demo）— Vibe Color 单入口、输入审计、基础校正、镜头匹配、独立风格；DaVinci Resolve DSH 插件。需要 macOS + Resolve Studio + Resolve MCP。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "host-impl.mjs",
    "host-base.mjs",
    "client.js",
    "lib/**/*.mjs",
    "lib/*.swift",
    "lib/*.py",
    "scripts/**/*.py",
    "lib/fixtures/**",
    "test/**",
    "bin/**",
    "assets/luts/official/library.json",
    "README.md",
    "USER_MANUAL.md",
    "docs/**/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "color-grading",
    "color-management",
    "davinci",
    "davinci-resolve",
    "dsh-plugin",
    "lut",
    "mcp",
    "resolve",
    "vibe-color",
    "video"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "os": [
    "darwin"
  ],
  "davinciConsole": {
    "platform": "darwin",
    "requires": {
      "resolve": "DaVinci Resolve Studio 18+（推荐 21.2）",
      "mcp": "davinci-resolve-mcp（工具名 resolve_*）",
      "binaries": [
        "ffmpeg",
        "ffprobe"
      ],
      "optional": [
        "unzip",
        "osascript",
        "sips",
        "say"
      ]
    },
    "notes": "LUT 官方包不随主包发布（授权原因），首次使用通过 restore.ensure 从厂商官方直链下载；本机已下载的 LUT 放在用户 LUT 目录或插件 data/luts/official。 视频抠像的 RVM/Depth ONNX 模型与本地 venv 不随 npm 包发布；缺失时 video.cutout 会明确失败，不退回静态/单帧。",
    "optional": [
      "python3.13",
      "onnxruntime"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JiangXingchen4210/dsh-davinci-console-demo.git"
  },
  "homepage": "https://github.com/JiangXingchen4210/dsh-davinci-console-demo#readme",
  "bugs": {
    "url": "https://github.com/JiangXingchen4210/dsh-davinci-console-demo/issues"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1"
  },
  "icon": "icon.svg"
}
